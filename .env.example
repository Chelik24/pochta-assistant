# Скопируйте этот файл в .env и заполните.
#
# ВАЖНО: пароль — НЕ обычный пароль от почты, а пароль для внешнего приложения.
#   Mail.ru: Настройки → Безопасность → Пароли для внешних приложений.
#            Тип доступа выбирайте «Только чтение и удаление писем» (IMAP, POP3),
#            НЕ «Полный доступ» — тогда отправка писем невозможна физически.
#   Gmail:   нужна включённая двухэтапная аутентификация, затем
#            https://myaccount.google.com/apppasswords → «Other (custom name)».
#            Пароль показывают один раз, 16 символов — вписывайте без пробелов.
#
# Файл .env никому не показывать и не класть в git (он уже в .gitignore).

# --- Ящик 1 ---
MAIL_1_USER=name@mail.ru
MAIL_1_PASSWORD=пароль_для_внешнего_приложения

# --- Ящик 2 (удалите, если ящик один) ---
MAIL_2_USER=name@gmail.com
MAIL_2_PASSWORD=шестнадцатьсимволов

# --- Ящик 3, 4, … по тому же образцу ---
# MAIL_3_USER=name@yandex.ru
# MAIL_3_PASSWORD=...

# Сервер IMAP определяется по адресу автоматически
# (mail.ru, gmail.com, yandex.ru, outlook.com, rambler.ru и родственные домены).
# Для корпоративной почты укажите его вручную:
# MAIL_3_HOST=imap.вашакомпания.ru
